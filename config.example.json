{
  "conversation": {
    "mode": "push_to_talk",
    "max_turns": 0,
    "log_dir": "./logs"
  },
  "recording": {
    "sample_rate": 16000,
    "channels": 1,
    "device": null,
    "output_dir": "./runtime/input"
  },
  "asr": {
    "provider": "faster_whisper",
    "model_size": "base",
    "device": "auto",
    "compute_type": "auto",
    "language": "zh",
    "beam_size": 5
  },
  "openclaw": {
    "adapter": "echo",
    "echo_prefix": "OpenClaw 收到：",
    "http": {
      "url": "http://127.0.0.1:8765/chat",
      "timeout_seconds": 60,
      "request_text_field": "text",
      "response_text_field": "reply"
    },
    "command": {
      "program": "python",
      "args": ["C:/path/to/openclaw_chat.py", "{text}"],
      "timeout_seconds": 120
    }
  },
  "tts": {
    "provider": "edge",
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "+0%",
    "output_dir": "./runtime/reply",
    "output_ext": "wav",
    "max_text_length": 4000
  },
  "playback": {
    "enabled": true,
    "player_script": "./scripts/play-local-audio.ps1",
    "timeout_seconds": 60
  }
}
